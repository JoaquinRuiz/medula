{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013WtzG5udPXsEzCAJFYTo8L","type":"tool_result","content":"1\t\"\"\"Validaciones de reservas.\n2\t\n3\tvalidar_sala() y validar_horario() son independientes entre sí.\n4\t\"\"\"\n5\tfrom datetime import datetime\n6\t\n7\tfrom app.config import SALAS\n8\t\n9\t\n10\tclass ValidationError(Exception):\n11\t    pass\n12\t\n13\t\n14\tdef validar_sala(sala: str) -> None:\n15\t    if not sala:\n16\t        raise ValidationError(\"sala requerida\")\n17\t    if sala not in SALAS:\n18\t        raise ValidationError(\"sala invalida\")\n19\t\n20\t\n21\t# --- Parámetros de reserva -------------------------------------------------\n22\t\n23\tDURACION_MAXIMA_MIN = 240\n24\tMINUTOS_PERMITIDOS = (0, 30)\n25\t\n26\t\n27\tdef _es_duracion_valida(duracion_min: int) -> bool:\n28\t    return 0 < duracion_min <= DURACION_MAXIMA_MIN\n29\t\n30\t\n31\t# ---------------------------------------------------------------------------\n32\t\n33\t\n34\tdef validar_horario(fecha: datetime, duracion_min: int) -> None:\n35\t    if not _es_duracion_valida(duracion_min):\n36\t        raise ValidationError(\"duracion invalida\")\n37\t    if fecha.minute not in MINUTOS_PERMITIDOS or fecha.second or fecha.microsecond:\n38\t        raise ValidationError(\"minutos invalidos\")\n39\t"}]},"parent_tool_use_id":null,"session_id":"ec02ebe8-512a-46e3-b7c7-b537273be797","uuid":"0743aa6e-2e56-4d69-80fd-758603336504","timestamp":"2026-09-29T14:20:47.420Z","tool_use_result":{"type":"text","file":{"filePath":"<runs>/d3/repo/app/validators.py","content":"\"\"\"Validaciones de reservas.\n\nvalidar_sala() y validar_horario() son independientes entre sí.\n\"\"\"\nfrom datetime import datetime\n\nfrom app.config import SALAS\n\n\nclass ValidationError(Exception):\n    pass\n\n\ndef validar_sala(sala: str) -> None:\n    if not sala:\n        raise ValidationError(\"sala requerida\")\n    if sala not in SALAS:\n        raise ValidationError(\"sala invalida\")\n\n\n# --- Parámetros de reserva -------------------------------------------------\n\nDURACION_MAXIMA_MIN = 240\nMINUTOS_PERMITIDOS = (0, 30)\n\n\ndef _es_duracion_valida(duracion_min: int) -> bool:\n    return 0 < duracion_min <= DURACION_MAXIMA_MIN\n\n\n# ---------------------------------------------------------------------------\n\n\ndef validar_horario(fecha: datetime, duracion_min: int) -> None:\n    if not _es_duracion_valida(duracion_min):\n        raise ValidationError(\"duracion invalida\")\n    if fecha.minute not in MINUTOS_PERMITIDOS or fecha.second or fecha.microsecond:\n        raise ValidationError(\"minutos invalidos\")\n","numLines":39,"startLine":1,"totalLines":39}}}
