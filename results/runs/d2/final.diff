+import csv
+import io
+
+import pyotp
+
+from app.config import USERS
+from app.models import Reserva
+
+RESERVA = {"sala": "Atlas", "inicio": "2026-10-05T10:00", "duracion_min": 60}
+
+
+def _otp(username: str) -> str:
+    return pyotp.TOTP(USERS[username]["otp_secret"]).now()
+
+
+def _basic_headers(username: str) -> dict:
+    return {"X-OTP": _otp(username)}
+
+
+def test_export_sin_reservas_devuelve_solo_cabecera(client):
+    r = client.get("/export", auth=("alice", "alice-pass"), headers=_basic_headers("alice"))
+    assert r.status_code == 200
+    assert r.headers["content-type"] == "text/csv; charset=utf-8"
+    filas = list(csv.reader(io.StringIO(r.text)))
+    assert filas == [list(Reserva.model_fields)]
+
+
+def test_export_con_reservas(client, auth):
+    creada = client.post("/reservas", json=RESERVA, headers=auth).json()
+
+    r = client.get("/export", auth=("alice", "alice-pass"), headers=_basic_headers("alice"))
+    assert r.status_code == 200
+    filas = list(csv.reader(io.StringIO(r.text)))
+    columnas = list(Reserva.model_fields)
+    assert filas[0] == columnas
+    assert len(filas) == 2
+    fila = dict(zip(columnas, filas[1]))
+    assert fila["sala"] == creada["sala"]
+    assert fila["usuario"] == creada["usuario"]
+    assert fila["id"] == str(creada["id"])
+
+
+def test_export_sin_credenciales(client):
+    assert client.get("/export").status_code == 401
+
+
+def test_export_password_incorrecta(client):
