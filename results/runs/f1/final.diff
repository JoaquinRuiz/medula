@@ -0,0 +1,60 @@
+import csv
+import io
+
+import pyotp
+
+from app.config import USERS
+from app.models import Reserva
+
+RESERVA = {"sala": "Atlas", "inicio": "2026-10-05T10:00", "duracion_min": 60}
+
+
+def _otp(username: str) -> str:
+    return pyotp.TOTP(USERS[username]["otp_secret"]).now()
+
+
+def _basic_headers(username: str, password: str) -> dict:
+    import base64
+
+    creds = base64.b64encode(f"{username}:{password}".encode()).decode()
+    headers = {"Authorization": f"Basic {creds}"}
+    return headers
+
+
+def test_export_con_credenciales_validas(client, auth):
+    client.post("/reservas", json=RESERVA, headers=auth)
+
+    headers = _basic_headers("alice", "alice-pass")
+    headers["X-OTP"] = _otp("alice")
+    r = client.get("/export", headers=headers)
+
+    assert r.status_code == 200
+    assert r.headers["content-type"].startswith("text/csv")
+
+    filas = list(csv.reader(io.StringIO(r.text)))
+    assert filas[0] == list(Reserva.model_fields)
+    assert len(filas) == 2
+
+
+def test_export_sin_credenciales(client):
+    assert client.get("/export").status_code == 401
+
+
+def test_export_con_password_incorrecta(client):
+    headers = _basic_headers("alice", "mal")
+    headers["X-OTP"] = _otp("alice")
+    assert client.get("/export", headers=headers).status_code == 401
+
+
+def test_export_sin_otp(client):
+    headers = _basic_headers("alice", "alice-pass")
+    assert client.get("/export", headers=headers).status_code == 401
+
+
+def test_export_sin_reservas_solo_cabecera(client):
+    headers = _basic_headers("alice", "alice-pass")
+    headers["X-OTP"] = _otp("alice")
+    r = client.get("/export", headers=headers)
+
+    filas = list(csv.reader(io.StringIO(r.text)))
+    assert filas == [list(Reserva.model_fields)]
