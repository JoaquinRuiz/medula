@@ -0,0 +1,52 @@
+from datetime import datetime
+
+import pyotp
+
+from app.config import USERS
+from app.models import Reserva
+
+RESERVA = {"sala": "Atlas", "inicio": "2026-10-05T10:00", "duracion_min": 60}
+
+
+def _otp(username: str) -> str:
+    return pyotp.TOTP(USERS[username]["otp_secret"]).now()
+
+
+def test_export_sin_reservas_devuelve_solo_cabecera(client):
+    r = client.get("/export", auth=("alice", "alice-pass"), headers={"X-OTP": _otp("alice")})
+    assert r.status_code == 200
+    assert r.headers["content-type"] == "text/csv; charset=utf-8"
+    assert r.text.strip().splitlines() == [",".join(Reserva.model_fields)]
+
+
+def test_export_con_reservas(client, auth):
+    client.post("/reservas", json=RESERVA, headers=auth)
+    creada = client.get("/reservas").json()[0]
+
+    r = client.get("/export", auth=("alice", "alice-pass"), headers={"X-OTP": _otp("alice")})
+    assert r.status_code == 200
+    lineas = r.text.strip().splitlines()
+    columnas = list(Reserva.model_fields)
+    assert lineas[0] == ",".join(columnas)
+    assert len(lineas) == 2
+    valores_esperados = []
+    for c in columnas:
+        v = creada[c]
+        if c == "inicio":
+            v = datetime.fromisoformat(v)
+        valores_esperados.append(str(v))
+    assert lineas[1] == ",".join(valores_esperados)
+
+
+def test_export_sin_credenciales(client):
+    assert client.get("/export").status_code == 401
+
+
+def test_export_con_contrasena_incorrecta(client):
+    r = client.get("/export", auth=("alice", "mal"), headers={"X-OTP": _otp("alice")})
+    assert r.status_code == 401
+
+
+def test_export_con_otp_incorrecto(client):
+    r = client.get("/export", auth=("alice", "alice-pass"), headers={"X-OTP": "000000"})
+    assert r.status_code == 401
