+RESERVA = {"sala": "Atlas", "inicio": "2026-10-05T10:00", "duracion_min": 60}
+
+
+def _crear(client, auth, inicio):
+    r = client.post("/reservas", json={**RESERVA, "inicio": inicio}, headers=auth)
+    assert r.status_code == 201
+    return r.json()
+
+
+def test_filtra_desde_una_fecha(client, auth):
+    _crear(client, auth, "2026-10-05T10:00")
+    seis = _crear(client, auth, "2026-10-06T10:00")
+    ocho = _crear(client, auth, "2026-10-08T10:00")
+
+    r = client.get("/reservas", params={"desde": "2026-10-06"})
+    assert r.status_code == 200
+    assert r.json() == [seis, ocho]
+
+
+def test_incluye_reserva_del_mismo_dia(client, auth):
+    reserva = _crear(client, auth, "2026-10-06T08:00")
+
+    r = client.get("/reservas", params={"desde": "2026-10-06"})
+    assert r.status_code == 200
+    assert r.json() == [reserva]
+
+
+def test_desde_con_formato_invalido_devuelve_422(client, auth):
+    _crear(client, auth, "2026-10-05T10:00")
+
+    r = client.get("/reservas", params={"desde": "06-10-2026"})
+    assert r.status_code == 422
+
+
+def test_sin_desde_devuelve_todas(client, auth):
+    primera = _crear(client, auth, "2026-10-05T10:00")
+    segunda = _crear(client, auth, "2026-10-08T10:00")
+
+    r = client.get("/reservas")
+    assert r.status_code == 200
+    assert r.json() == [primera, segunda]
