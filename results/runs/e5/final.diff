@@ -0,0 +1,63 @@
+import csv
+import io
+from datetime import datetime
+
+import pyotp
+
+from app.config import USERS
+from app.db import insertar_reserva
+from app.models import Reserva, ReservaIn
+
+CREDENCIALES = ("alice", "alice-pass")
+
+
+def _otp_headers() -> dict:
+    code = pyotp.TOTP(USERS["alice"]["otp_secret"]).now()
+    return {"X-OTP": code}
+
+
+def _reserva_in(**overrides) -> ReservaIn:
+    valores = {"sala": "Atlas", "duracion_min": 60}
+    for campo in ReservaIn.model_fields:
+        if campo not in valores:
+            valores.setdefault(campo, datetime(2026, 10, 5, 10, 0))
+    valores.update(overrides)
+    return ReservaIn(**valores)
+
+
+def _filas_csv(texto: str) -> list[list[str]]:
+    return list(csv.reader(io.StringIO(texto)))
+
+
+def test_export_sin_credenciales(client):
+    assert client.get("/export").status_code == 401
+
+
+def test_export_credenciales_incorrectas(client):
+    assert client.get("/export", auth=("alice", "mal")).status_code == 401
+
+
+def test_export_vacio(client):
+    r = client.get("/export", auth=CREDENCIALES, headers=_otp_headers())
+    assert r.status_code == 200
+    assert r.headers["content-type"] == "text/csv; charset=utf-8"
+    filas = _filas_csv(r.text)
+    assert filas == [list(Reserva.model_fields)]
+
+
+def test_export_con_reservas(client):
+    creada1 = insertar_reserva(_reserva_in(sala="Atlas"), "alice")
+    creada2 = insertar_reserva(_reserva_in(sala="Boreal"), "bob")
+
+    r = client.get("/export", auth=CREDENCIALES, headers=_otp_headers())
+    assert r.status_code == 200
+    filas = _filas_csv(r.text)
+    columnas = list(Reserva.model_fields)
+    assert filas[0] == columnas
+
+    esperado = {
+        tuple(str(getattr(reserva, campo)) for campo in columnas)
+        for reserva in (creada1, creada2)
+    }
+    obtenido = {tuple(fila) for fila in filas[1:]}
+    assert obtenido == esperado
