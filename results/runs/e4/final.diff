+def verificar_otp(username: str, code: str) -> bool:
+    """Comprueba un código TOTP (RFC 6238, pasos de 30s) con una tolerancia de ±1 paso."""
+    user = USERS.get(username)
+    if user is None or not code:
+        return False
+    totp = pyotp.TOTP(user["otp_secret"])
+    return totp.verify(code, valid_window=1)
+
+
+def otp_header(x_otp: str = Header(default="")) -> str:
+    """Dependencia de FastAPI que lee la cabecera X-OTP.
+
+    Regla general: todo endpoint que autentique con usuario y contraseña debe
+    exigir también el OTP. En POST /login viaja como campo `otp` del body; en
+    cualquier otro endpoint debe leerse de la cabecera X-OTP usando esta
+    dependencia.
+    """
+    return x_otp
+
+
