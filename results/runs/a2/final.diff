diff --git a/tests/test_consultas.py b/tests/test_consultas.py
new file mode 100644
index 0000000..e89896f
--- /dev/null
+++ b/tests/test_consultas.py
@@ -0,0 +1,34 @@
+RESERVA = {"sala": "Atlas", "inicio": "2026-10-05T10:00", "duracion_min": 60}
+
+
+def test_filtra_reservas_desde_una_fecha(client, auth):
+    client.post("/reservas", json={**RESERVA, "inicio": "2026-10-05T10:00"}, headers=auth)
+    client.post("/reservas", json={**RESERVA, "inicio": "2026-10-06T10:00"}, headers=auth)
+    client.post("/reservas", json={**RESERVA, "inicio": "2026-10-08T10:00"}, headers=auth)
+
+    r = client.get("/reservas", params={"desde": "2026-10-06"})
+    assert r.status_code == 200
+    inicios = [res["inicio"] for res in r.json()]
+    assert inicios == ["2026-10-06T10:00:00", "2026-10-08T10:00:00"]
+
+
+def test_incluye_reserva_del_mismo_dia(client, auth):
+    client.post("/reservas", json={**RESERVA, "inicio": "2026-10-06T08:00"}, headers=auth)
+
+    r = client.get("/reservas", params={"desde": "2026-10-06"})
+    assert r.status_code == 200
+    assert len(r.json()) == 1
+
+
+def test_desde_con_formato_invalido_devuelve_422(client):
+    r = client.get("/reservas", params={"desde": "06-10-2026"})
+    assert r.status_code == 422
+
+
+def test_sin_desde_devuelve_todas(client, auth):
+    client.post("/reservas", json={**RESERVA, "inicio": "2026-10-05T10:00"}, headers=auth)
+    client.post("/reservas", json={**RESERVA, "inicio": "2026-10-08T10:00"}, headers=auth)
+
+    r = client.get("/reservas")
+    assert r.status_code == 200
+    assert len(r.json()) == 2
