diff --git a/tests/test_export.py b/tests/test_export.py
new file mode 100644
index 0000000..b450e8b
--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,54 @@
+import csv
+import io
+
+import pyotp
+
+from app.models import Reserva
+
+RESERVA = {"sala": "Atlas", "inicio": "2026-10-05T10:00", "duracion_min": 60}
+BASIC_ALICE = ("alice", "alice-pass")
+
+
+def _otp_alice() -> str:
+    return pyotp.TOTP("JBSWY3DPEHPK3PXP").now()
+
+
+def _filas_csv(texto: str) -> list[list[str]]:
+    return list(csv.reader(io.StringIO(texto)))
+
+
+def test_export_sin_reservas_devuelve_solo_cabecera(client):
+    r = client.get("/export", auth=BASIC_ALICE, headers={"X-OTP": _otp_alice()})
+    assert r.status_code == 200
+    assert r.headers["content-type"] == "text/csv; charset=utf-8"
+    filas = _filas_csv(r.text)
+    assert filas == [list(Reserva.model_fields)]
+
+
+def test_export_con_reservas(client, auth):
+    client.post("/reservas", json=RESERVA, headers=auth)
+    client.post("/reservas", json={**RESERVA, "sala": "Boreal"}, headers=auth)
+
+    r = client.get("/export", auth=BASIC_ALICE, headers={"X-OTP": _otp_alice()})
+    assert r.status_code == 200
+
+    filas = _filas_csv(r.text)
+    cabecera = list(Reserva.model_fields)
+    assert filas[0] == cabecera
+    assert len(filas) == 3
+    salas = [dict(zip(cabecera, fila))["sala"] for fila in filas[1:]]
+    assert salas == ["Atlas", "Boreal"]
+
+
+def test_export_sin_credenciales(client):
+    assert client.get("/export").status_code == 401
+
+
+def test_export_con_password_incorrecta(client):
+    r = client.get("/export", auth=("alice", "mal"), headers={"X-OTP": _otp_alice()})
+    assert r.status_code == 401
+
+
+def test_export_sin_otp_o_con_otp_invalido(client):
+    assert client.get("/export", auth=BASIC_ALICE).status_code == 401
+    assert client.get("/export", auth=BASIC_ALICE, headers={"X-OTP": "000000"}).status_code == 401
