-"""Autenticación: login con usuario y contraseña y sesiones en memoria."""
+"""Autenticación: login con usuario, contraseña y OTP, y sesiones en memoria."""
 import secrets
 from dataclasses import dataclass
 
+import pyotp
+from fastapi import Header
+
 from app.config import USERS
 
 
@@ -18,11 +21,36 @@ class Session:
 _sessions: dict[str, Session] = {}
 
 
-def login(username: str, password: str) -> Session:
-    """Valida las credenciales y abre una sesión. Lanza AuthError si no son válidas."""
+def verificar_otp(username: str, code: str) -> bool:
+    """Comprueba un código TOTP (RFC 6238, pasos de 30s, tolerancia de ±1 paso)."""
+    if not code:
+        return False
+    user = USERS.get(username)
+    if user is None:
+        return False
+    secret = user.get("otp_secret")
+    if not secret:
+        return False
+    return pyotp.TOTP(secret).verify(code, valid_window=1)
+
+
+def otp_header(x_otp: str = Header(default="", alias="X-OTP")) -> str:
+    """Dependencia FastAPI que lee la cabecera X-OTP y devuelve su valor ("" si no viene).
+
+    Regla general: todo endpoint que autentique con usuario y contraseña debe exigir
+    también el OTP: en POST /login como campo `otp` del body, y en cualquier otro
+    endpoint como cabecera `X-OTP`, leída con esta dependencia.
+    """
+    return x_otp
+
+
+def login(username: str, password: str, otp: str) -> Session:
+    """Valida las credenciales y el OTP y abre una sesión. Lanza AuthError si no son válidas."""
     user = USERS.get(username)
     if user is None or not secrets.compare_digest(user["password"], password):
         raise AuthError("credenciales invalidas")
+    if not verificar_otp(username, otp):
+        raise AuthError("otp invalido")
     session = Session(token=secrets.token_urlsafe(24), username=username)
     _sessions[session.token] = session
     return session
