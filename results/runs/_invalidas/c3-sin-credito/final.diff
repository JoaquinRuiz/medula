diff --git a/tests/test_export.py b/tests/test_export.py
new file mode 100644
index 0000000..0f6737a
--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,43 @@
+import csv
+import io
+
+from app.models import Reserva
+
+RESERVA = {"sala": "Atlas", "fecha": "2026-10-05T10:00", "duracion_min": 60}
+
+
+def _basic_auth(username: str, password: str) -> dict:
+    import base64
+
+    token = base64.b64encode(f"{username}:{password}".encode()).decode()
+    return {"Authorization": f"Basic {token}"}
+
+
+def test_export_sin_reservas(client):
+    r = client.get("/export", headers=_basic_auth("alice", "alice-pass"))
+    assert r.status_code == 200
+    assert r.headers["content-type"] == "text/csv; charset=utf-8"
+    filas = list(csv.reader(io.StringIO(r.text)))
+    assert filas == [list(Reserva.model_fields)]
+
+
+def test_export_con_reservas(client, auth):
+    client.post("/reservas", json=RESERVA, headers=auth)
+    r = client.get("/export", headers=_basic_auth("alice", "alice-pass"))
+    assert r.status_code == 200
+    filas = list(csv.reader(io.StringIO(r.text)))
+    columnas = list(Reserva.model_fields)
+    assert filas[0] == columnas
+    assert len(filas) == 2
+    fila = dict(zip(columnas, filas[1]))
+    assert fila["sala"] == "Atlas"
+    assert fila["usuario"] == "alice"
+
+
+def test_export_sin_credenciales(client):
+    assert client.get("/export").status_code == 401
+
+
+def test_export_con_contrasena_incorrecta(client):
+    r = client.get("/export", headers=_basic_auth("alice", "mal"))
+    assert r.status_code == 401
