# Copia a .env y rellena. .env no se versiona.
OPENROUTER_API_KEY=
# Modelo y esfuerzo de los agentes, iguales en todos los modos.
MEDULA_AGENT_MODEL=anthropic/claude-sonnet-5
MEDULA_AGENT_EFFORT=high
# Opcional: dónde se crean los workspaces de cada run (fuera del repo).
# MEDULA_RUNS_DIR=/tmp/mr

# Decisores (E-03 en adelante): Jev, y el camino lento (Sonnet y, si no resuelve, Opus).
MEDULA_JEV_MODEL=typesafe/jev-1.13
MEDULA_SLOW_MODEL=anthropic/claude-sonnet-5
MEDULA_SLOW_ESCALATION_MODEL=anthropic/claude-opus-5.5
